{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://netscope.invalid/schemas/offline-benchmark-result-v1.json",
  "title": "NetScope offline benchmark result",
  "description": "Version 1 envelope emitted by scripts/perf/run_offline.py.",
  "type": "object",
  "required": [
    "schema_version",
    "created_at_utc",
    "invocation",
    "source",
    "binary",
    "environment",
    "method",
    "workloads",
    "records",
    "aggregates"
  ],
  "properties": {
   "schema_version": { "const": 1 },
   "created_at_utc": { "type": "string", "format": "date-time" },
    "report_generated_at_utc": { "type": "string", "format": "date-time" },
    "invocation": { "type": "string" },
    "source": { "$ref": "#/$defs/source" },
    "binary": { "$ref": "#/$defs/binary" },
    "environment": { "type": "object" },
    "method": { "type": "object" },
    "workloads": {
      "type": "array",
      "items": { "$ref": "#/$defs/workload" }
    },
    "records": {
      "type": "array",
      "items": { "$ref": "#/$defs/run" }
    },
    "aggregates": {
      "type": "array",
      "items": { "$ref": "#/$defs/aggregate" }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": ["commit", "dirty", "source_tree_sha256"],
      "properties": {
        "commit": { "type": "string" },
        "dirty": { "type": "boolean" },
        "source_tree_sha256": { "$ref": "#/$defs/sha256" },
        "status_porcelain": { "type": "array", "items": { "type": "string" } },
        "tracked_diff_sha256": { "$ref": "#/$defs/sha256" },
        "untracked_files": { "type": "array", "items": { "type": "object" } },
        "fingerprint_method": { "type": "string" },
        "snapshot": {
          "type": "object",
          "required": ["complete", "patch_path", "untracked_root", "reconstruction_guide"],
          "properties": {
            "complete": { "const": true },
            "patch_path": { "type": "string" },
            "untracked_root": { "type": "string" },
            "reconstruction_guide": { "type": "string" }
          }
        }
      },
      "additionalProperties": true
    },
    "binary": {
      "type": "object",
      "required": ["path", "sha256", "version", "build_command"],
      "properties": {
        "path": { "type": "string" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "version": { "type": "string" },
        "build_command": { "type": "string" }
      },
      "additionalProperties": true
    },
    "workload": {
      "type": "object",
      "required": [
        "schema_version",
        "workload",
        "packet_count",
        "pcap_sha256",
        "pcap_bytes",
        "wire_bytes",
        "packet_size_distribution_bytes",
        "protocol_mix_packets",
        "flow_cardinality"
      ],
      "properties": {
        "schema_version": { "enum": [1, 2] },
        "generator": { "type": "string" },
        "workload": { "type": "string" },
        "description": { "type": "string" },
        "synthetic": { "type": "boolean" },
        "provenance": { "type": "string" },
        "seed": { "type": "string" },
        "packet_count": { "type": "integer", "minimum": 1 },
        "pcap_file": { "type": "string" },
        "pcap_sha256": { "$ref": "#/$defs/sha256" },
        "pcap_bytes": { "type": "integer", "minimum": 24 },
        "wire_bytes": { "type": "integer", "minimum": 1 },
        "link_type": { "type": "string" },
        "captured_length_equals_wire_length": { "type": "boolean" },
        "checksums": { "type": "string" },
        "packet_size_distribution_bytes": { "type": "object", "additionalProperties": { "type": "integer" } },
        "protocol_mix_packets": { "type": "object", "additionalProperties": { "type": "integer" } },
        "flow_cardinality": { "type": "integer", "minimum": 0 },
        "flow_cardinality_definition": { "type": "string" },
        "timestamp_spacing_microseconds": { "type": "integer", "minimum": 1 },
        "timestamp_start_unix_seconds": { "type": "integer" },
        "timestamp_end_unix_seconds": { "type": "number" }
      },
      "additionalProperties": true
    },
    "run": {
      "type": "object",
      "required": [
        "schema_version",
        "run_id",
        "scenario_id",
        "phase",
        "repetition",
        "started_at_utc",
        "workload",
        "mode",
        "requested_workers",
        "dashboard_enabled",
        "anomaly_detection_enabled",
        "command",
        "config_path",
        "binary_sha256",
        "source_commit",
        "source_dirty",
        "source_tree_sha256",
        "exit_code",
        "resource_adapter",
        "resource_readings",
        "elapsed_wall_seconds",
        "metrics",
        "validation"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "run_id": { "type": "string" },
        "scenario_id": { "type": "string" },
        "phase": { "enum": ["warmup", "measured"] },
        "repetition": { "type": "integer", "minimum": 1 },
        "started_at_utc": { "type": "string", "format": "date-time" },
        "workload": { "$ref": "#/$defs/workload" },
        "mode": { "enum": ["inline", "pipeline"] },
        "requested_workers": { "type": ["integer", "null"], "minimum": 1 },
        "dashboard_enabled": { "type": "boolean" },
        "anomaly_detection_enabled": { "type": "boolean" },
        "command": { "type": "array", "items": { "type": "string" } },
        "config_path": { "type": "string" },
        "binary_sha256": { "$ref": "#/$defs/sha256" },
        "source_commit": { "type": "string" },
        "source_dirty": { "type": "boolean" },
        "source_tree_sha256": { "$ref": "#/$defs/sha256" },
        "exit_code": { "type": "integer" },
        "resource_adapter": { "type": "string" },
        "raw_stdout_path": { "type": "string" },
        "raw_stderr_path": { "type": "string" },
        "raw_resource_output_path": { "type": "string" },
        "resource_readings": { "type": "object" },
        "elapsed_wall_seconds": { "type": "number", "minimum": 0 },
        "metrics": { "type": "object" },
        "dashboard_probe": { "type": ["object", "null"] },
        "run_summary": { "type": ["object", "null"] },
        "validation": {
          "type": "object",
          "required": ["passed", "errors"],
          "properties": {
            "passed": { "type": "boolean" },
            "errors": { "type": "array", "items": { "type": "string" } }
          }
        }
      },
      "additionalProperties": true
    },
    "aggregate": {
      "type": "object",
      "required": [
        "scenario_id",
        "workload",
        "packet_count",
        "pcap_sha256",
        "mode",
        "requested_workers",
        "repetitions",
        "deterministic_summary_across_repetitions",
        "metrics",
        "run_ids"
      ],
      "properties": {
        "scenario_id": { "type": "string" },
        "workload": { "type": "string" },
        "packet_count": { "type": "integer" },
        "pcap_sha256": { "$ref": "#/$defs/sha256" },
        "mode": { "enum": ["inline", "pipeline"] },
        "requested_workers": { "type": ["integer", "null"] },
        "dashboard_enabled": { "type": "boolean" },
        "anomaly_detection_enabled": { "type": "boolean" },
        "repetitions": { "type": "integer", "minimum": 5 },
        "deterministic_summary_across_repetitions": { "type": "boolean" },
        "metrics": { "type": "object" },
        "dashboard_metrics": { "type": ["object", "null"] },
        "run_ids": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "additionalProperties": true
}
